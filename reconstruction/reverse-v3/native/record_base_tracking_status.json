 "hand_check": {
  "sample": 3,
  "confirmed": [
   {
    "site": "0x005b8bc4",
    "method": "World -[craftOrConfigureItem:atWorkbench:withBlockhead:count:]",
    "field_offset": 0,
    "kind": "read",
    "why_it_is_real": "the two calls immediately above write into fp-0x130 - bl 0x001c2918 (memcpy) with r1 = fp-0x130, and movw r2,#0x7c ; sub r1,fp,#0x130 ; bl 0x001c2924 (memset) - so fp-0x130 is a record buffer by construction and ldr r0,[fp,#-0x130] is record+0",
    "observed_use": "the value is compared with #0x67 (103) at 0x005b8bc8 - an observed use of f0, not a name for it"
   }
  ],
  "refuted": [
   {
    "site": "0x005b87c8",
    "method": "World -[craftItem:atWorkbench:withBlockhead:count:]",
    "claimed": 76,
    "actually": "str r0,[fp,#-0x64] stores the return value of the objc_msgSend immediately above into an ordinary local"
   },
   {
    "site": "0x005b6ec8",
    "method": "World -[fullyLoadIfNeededAroundPos:clientLightBlockIndex:forBlockhead:]",
    "claimed": 84,
    "actually": "part of a chain of cmp r0,[fp,#k] comparisons against locals"
   }
  ],
  "precision_estimate": "1 of 3 on the first hand check - the tool's access hits must be treated as candidates at roughly that rate until the mechanism below is fixed",
  "mechanism_of_the_false_positives": "a method that contains ANY proven record base makes every [fp,#k] in it a candidate under some base's displacement, so ordinary locals get matched - the very collision the sealed note warned about, now with a measured example rather than a warning"
 },
 "false_negative_cause": "the length constant 0x7c is required NEAR the call, and in PaintMixUI -[craftButton:] it is materialised in the SIBLING branch (the memset path at 0x00673408) while the memcpy call at 0x006733f0 sits in the other branch - so a base detected only from a same-block length constant misses that method's record entirely"
}
